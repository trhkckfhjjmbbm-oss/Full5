-- Barny: Rick and Morty — Часть 5/5 (Способности + Феникс + Бомба)
local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local TS = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local LP = Players.LocalPlayer
local B = _G.Barny.B
local P = _G.Barny.P
local MakeHeader = _G.Barny.MakeHeader
local MakeBtn = _G.Barny.MakeBtn

-- ========== ЧЁРНЫЙ ЭКРАН ==========
local BlackGui = Instance.new("ScreenGui")
BlackGui.Name = "PhoenixBlack"
BlackGui.ResetOnSpawn = false
BlackGui.DisplayOrder = 999999
BlackGui.IgnoreGuiInset = true
BlackGui.Parent = LP:WaitForChild("PlayerGui")

local BlackFrame = Instance.new("Frame")
BlackFrame.Size = UDim2.new(1,0,1,0)
BlackFrame.BackgroundColor3 = Color3.fromRGB(0,0,0)
BlackFrame.BackgroundTransparency = 1
BlackFrame.BorderSizePixel = 0
BlackFrame.Visible = false
BlackFrame.ZIndex = 999999
BlackFrame.Parent = BlackGui

local CountText = Instance.new("TextLabel")
CountText.Size = UDim2.new(1,0,0,60)
CountText.Position = UDim2.new(0,0,0.5,-30)
CountText.BackgroundTransparency = 1
CountText.Text = ""
CountText.TextColor3 = Color3.fromRGB(255,255,255)
CountText.Font = Enum.Font.Code
CountText.TextSize = 40
CountText.ZIndex = 1000000
CountText.Parent = BlackFrame

local CapsulePos = nil
local PhoenixActive = false

local function ShowBlackScreen(cb)
    BlackFrame.Visible = true
    TS:Create(BlackFrame, TweenInfo.new(0.4), {BackgroundTransparency = 0}):Play()
    task.wait(0.4)
    CountText.Text = "ОПЕРАЦИЯ ФЕНИКСА 3..."
    task.wait(1)
    CountText.Text = "ОПЕРАЦИЯ ФЕНИКСА 2..."
    task.wait(1)
    CountText.Text = "ОПЕРАЦИЯ ФЕНИКСА 1..."
    task.wait(1)
    CountText.Text = "УСПЕШНО!"
    CountText.TextColor3 = Color3.fromRGB(0,255,0)
    task.wait(0.7)
    if cb then cb() end
    TS:Create(BlackFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    task.wait(0.5)
    BlackFrame.Visible = false
end

-- ========== КАПСУЛА ==========
local function CreatePhoenixCapsule(pos)
    if workspace:FindFirstChild("PhoenixCapsule") then workspace.PhoenixCapsule:Destroy() end
    local m = Instance.new("Model")
    m.Name = "PhoenixCapsule"
    local base = P("Base", Vector3.new(1.5,6,6), pos, Color3.fromRGB(30,30,40), Enum.Material.Metal, m)
    base.Shape = Enum.PartType.Cylinder
    base.CFrame = CFrame.new(pos) * CFrame.Angles(0,0,math.rad(90))
    local glass = P("Glass", Vector3.new(12,4,4), pos+Vector3.new(0,7,0), Color3.fromRGB(0,255,200), Enum.Material.Glass, m)
    glass.Shape = Enum.PartType.Cylinder
    glass.CFrame = CFrame.new(pos+Vector3.new(0,7,0)) * CFrame.Angles(0,0,math.rad(90))
    glass.CanCollide = false
    glass.Transparency = 0.5
    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(0,255,200)
    light.Range = 15
    light.Brightness = 4
    light.Parent = glass
    m.Parent = workspace
end

-- ========== БОМБА ==========
local function CreateBomb(pos)
    if workspace:FindFirstChild("PrimeBomb") then workspace.PrimeBomb:Destroy() end
    local m = Instance.new("Model")
    m.Name = "PrimeBomb"
    local core = P("Core", Vector3.new(4,4,4), pos+Vector3.new(0,3,0), Color3.fromRGB(20,20,20), Enum.Material.Metal, m)
    core.Shape = Enum.PartType.Ball
    core.CanCollide = false
    for i = 1, 20 do
        local a1 = math.random() * math.pi * 2
        local a2 = math.random() * math.pi
        local r = 2.2
        local spike = P("S"..i, Vector3.new(0.8,0.8,0.8), core.Position+Vector3.new(math.sin(a2)*math.cos(a1)*r, math.cos(a2)*r, math.sin(a2)*math.sin(a1)*r), Color3.fromRGB(200,0,255), Enum.Material.Neon, m)
        spike.Shape = Enum.PartType.Ball
        spike.CanCollide = false
    end
    m.Parent = workspace
end

local function Explode(core)
    local pos = core.Position
    local explosion = Instance.new("Explosion")
    explosion.Position = pos
    explosion.BlastRadius = 100
    explosion.BlastPressure = 100000
    explosion.ExplosionType = Enum.ExplosionType.NoCraters
    explosion.Visible = true
    explosion.Parent = workspace
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
                if part and (part.Position - pos).Magnitude < 100 then
                    hum.Health = 0
                end
            end
        end
    end
    Debris:AddItem(core, 2)
end

-- ========== КНОПКИ ==========
MakeHeader("── ОПЕРАЦИЯ ФЕНИКС ──", Color3.fromRGB(0, 100, 100))

MakeBtn("СОЗДАТЬ КАПСУЛУ", Color3.fromRGB(0, 100, 100), function()
    local ch = LP.Character
    if not ch then return end
    local hr = ch:FindFirstChild("HumanoidRootPart")
    if not hr then return end
    CapsulePos = hr.Position + hr.CFrame.LookVector * 8
    CreatePhoenixCapsule(CapsulePos)
end)

local phoenixBtn = MakeBtn("ОПЕРАЦИЯ ФЕНИКС: ВЫКЛ", Color3.fromRGB(100,50,0), function()
    PhoenixActive = not PhoenixActive
    phoenixBtn.Text = "ОПЕРАЦИЯ ФЕНИКС: " .. (PhoenixActive and "ВКЛ" or "ВЫКЛ")
    phoenixBtn.BackgroundColor3 = PhoenixActive and Color3.fromRGB(0,150,0) or Color3.fromRGB(100,50,0)
end)

MakeHeader("── БОМБА ПРАЙМА ──", Color3.fromRGB(80, 0, 100))

MakeBtn("СОЗДАТЬ БОМБУ", Color3.fromRGB(80, 0, 100), function()
    local ch = LP.Character
    if not ch then return end
    local hr = ch:FindFirstChild("HumanoidRootPart")
    if not hr then return end
    CreateBomb(hr.Position + hr.CFrame.LookVector * 8)
end)

MakeBtn("ВЗОРВАТЬ", Color3.fromRGB(100, 0, 0), function()
    local bomb = workspace:FindFirstChild("PrimeBomb")
    if not bomb then return end
    local core = bomb:FindFirstChild("Core")
    if not core then return end
    task.spawn(function()
        for i = 1, 5 do
            core.Color = Color3.fromRGB(255,0,255)
            core.Transparency = 0.3
            task.wait(0.15)
            core.Color = Color3.fromRGB(20,20,20)
            core.Transparency = 0
            task.wait(0.15)
        end
        Explode(core)
    end)
end)

-- ========== РЕСПАВН ==========
LP.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if PhoenixActive and CapsulePos then
        ShowBlackScreen(function()
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(CapsulePos + Vector3.new(0,5,0))
                hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
            end
        end)
    end
end)

print("[Barny] Часть 5/5 загружена (Способности + Феникс + Бомба)")
